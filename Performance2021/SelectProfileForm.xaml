<Window x:Class="SelectProfileForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPwpf"
        mc:Ignorable="d"
        Title="Select Profile" Height="300" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
      <Button Click="Button_Click" x:Name="OpenButton" Width="350" Margin="5,5,20,5" FontWeight="Bold" FontSize="16" IsDefault="True" >Open Selected</Button>
            <Button Click="Button_Click_1" Width="80" Margin="20,5,5,5" FontSize="12" IsCancel="True" >Open Last</Button>
        </StackPanel>
        <ListView Name="Lista" DisplayMemberPath="Descrizione" ItemsSource="{Binding ListaProfili}"
              ScrollViewer.VerticalScrollBarVisibility="Visible" 
              Grid.Column="0" Grid.Row="1" AllowDrop="False"
              MouseDoubleClick="Lista_MouseDoubleClick"
                  MouseLeftButtonUp="Lista_MouseLeftButtonUp" MouseRightButtonUp="Lista_MouseLeftButtonUp"
              >
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

    </Grid>
</Window>
