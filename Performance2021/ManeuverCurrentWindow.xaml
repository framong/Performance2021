<Window x:Class="ManeuverCurrentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPwpf"
        mc:Ignorable="d"
        Title="Long Range Auto Check - Calibrazione da manovre" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <Label Content="Fascia di tempo (min)" VerticalAlignment="Center" />
      <TextBox Name="txt_TimeWindow" Width="50" Text="30" VerticalContentAlignment="Center" Height="24" />
      <Label Content="Zona (nm)" Margin="10,0,0,0" VerticalAlignment="Center" />
      <TextBox Name="txt_ZoneNm" Width="50" Text="0.5" VerticalContentAlignment="Center" Height="24" />
      <Button Name="btn_Ricalcola" Content="Ricalcola" Width="90" Margin="10,0,0,0" Click="btn_Ricalcola_Click" />
      <Button Name="btn_Copia" Content="Copia negli appunti" Width="140" Margin="10,0,0,0" Click="btn_Copia_Click" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Manovre">
        <DataGrid Name="grd_Manovre" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" AlternatingRowBackground="#F4F4F4">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Ora" Binding="{Binding TackChangeTime, StringFormat=HH:mm:ss}" />
            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" />
            <DataGridTextColumn Header="Mura" Binding="{Binding Mura}" />
            <DataGridTextColumn Header="Fascia" Binding="{Binding TimeGroupId}" />
            <DataGridTextColumn Header="Zona" Binding="{Binding ZoneId}" />
            <DataGridTextColumn Header="Offset prima [°]" Binding="{Binding OffsetBefore, StringFormat=0.00}" />
            <DataGridTextColumn Header="Offset dopo [°]" Binding="{Binding OffsetAfter, StringFormat=0.00}" />
            <DataGridTextColumn Header="Corrente set [°]" Binding="{Binding CurrentSet, StringFormat=0}" />
            <DataGridTextColumn Header="Corrente drift [kn]" Binding="{Binding CurrentDrift, StringFormat=0.00}" />
            <DataGridTextColumn Header="Residuo globale [kn]" Binding="{Binding GlobalPairResidual, StringFormat=0.00}" />
            <DataGridTextColumn Header="Converge" Binding="{Binding Converge}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Per fascia di tempo">
        <DataGrid Name="grd_Tempo" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" AlternatingRowBackground="#F4F4F4">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Fascia" Binding="{Binding Id}" />
            <DataGridTextColumn Header="Intervallo" Binding="{Binding Label}" />
            <DataGridTextColumn Header="Manovre" Binding="{Binding ManeuverCount}" />
            <DataGridTextColumn Header="Corrente set [°]" Binding="{Binding CurrentSet, StringFormat=0}" />
            <DataGridTextColumn Header="Corrente drift [kn]" Binding="{Binding CurrentDrift, StringFormat=0.00}" />
            <DataGridTextColumn Header="RMS [kn]" Binding="{Binding Rms, StringFormat=0.000}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Per zona">
        <DataGrid Name="grd_Zone" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" AlternatingRowBackground="#F4F4F4">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Zona" Binding="{Binding Id}" />
            <DataGridTextColumn Header="Nome" Binding="{Binding Label}" />
            <DataGridTextColumn Header="Manovre" Binding="{Binding ManeuverCount}" />
            <DataGridTextColumn Header="Lat" Binding="{Binding MeanLat, StringFormat=0.0000}" />
            <DataGridTextColumn Header="Lon" Binding="{Binding MeanLon, StringFormat=0.0000}" />
            <DataGridTextColumn Header="Corrente set [°]" Binding="{Binding CurrentSet, StringFormat=0}" />
            <DataGridTextColumn Header="Corrente drift [kn]" Binding="{Binding CurrentDrift, StringFormat=0.00}" />
            <DataGridTextColumn Header="RMS [kn]" Binding="{Binding Rms, StringFormat=0.000}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Margin="0,8,0,0" Padding="6" BorderBrush="Gray" BorderThickness="1">
      <TextBlock Name="txt_Correzioni" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
