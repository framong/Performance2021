<UserControl x:Class="ctrl_BasicSciChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sc="http://schemas.abtsoftware.co.uk/scichart"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	

	<Grid Name="gridChart" >
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" ></RowDefinition>
      <RowDefinition Height="4" ></RowDefinition>
    </Grid.RowDefinitions>
		<GridSplitter Name="SplitGraficiBasic"  Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Background="LightGray" Grid.ColumnSpan="2" AllowDrop="True">
		</GridSplitter>
		<sc:SciChartSurface x:Name="SCsurface" AllowDrop="true" sc:ThemeManager.Theme="BrightSpark" Margin="3,2,3,2"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  MinHeight="200" >
      <sc:SciChartSurface.ChartModifier>
        <sc:ModifierGroup ReceiveHandledEvents="True">
          <sc:RubberBandXyZoomModifier Name="ScRubberBandXyZoomModifier" IsAnimated="False" IsEnabled="False" IsXAxisOnly="False" RubberBandFill="#99FF0000"></sc:RubberBandXyZoomModifier>
          <sc:MouseWheelZoomModifier Name="ScMouseWheelZoomModifier" XyDirection="{Binding ZoomMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></sc:MouseWheelZoomModifier>
          <sc:ZoomPanModifier Name="ScZoomPanModifier" ReceiveHandledEvents="True" IsEnabled="True"/>
          <sc:ZoomExtentsModifier ExecuteOn="MouseDoubleClick"/>
        </sc:ModifierGroup>
      </sc:SciChartSurface.ChartModifier>
    </sc:SciChartSurface>
    <Button Name="btn_SelectChannels" Content="Sel" Height="20" Margin="2,2,2,2" VerticalAlignment="Top" Width="25" HorizontalAlignment="left"/>
    <Button Name="btn_180mode"  Height="20" Margin="2,2,2,2"  BorderThickness="1" VerticalAlignment="Top" Width="50" ToolTip="Toggle Normal/Absolute/Single Tack"  HorizontalAlignment="Right">Normal</Button>
  </Grid>
</UserControl>