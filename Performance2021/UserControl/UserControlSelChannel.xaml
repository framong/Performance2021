<Window x:Class="UserControlSelChannel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPwpf"
        mc:Ignorable="d"
        Title="Select Channel" Height="450" Width="400" WindowStyle="ToolWindow" MaxWidth="500" MinWidth="300" MinHeight="402">

  <Grid Name="GrigliaBase">
    <Grid.RowDefinitions>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="50"></RowDefinition>
      <RowDefinition Height="20"></RowDefinition>
      <RowDefinition Height="*"></RowDefinition>
    </Grid.RowDefinitions>
      <ToolBar Grid.Row="0">
        <Button Name="btn_Select" Background="LightGreen" Margin="10,2,10,2" Width="120">Select</Button>
        <Button Name="btn_Close" Background="OrangeRed" Margin="10,2,10,2" Width="100">Cancel</Button>
      </ToolBar>
    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <Label Name="lbl_MainVar" Margin="0,0,0,0"  Height="30">X axis Variable:</Label>
      <ComboBox Name="cb_CanaleAscissa" Margin="0,0,0,0" Width="Auto" MinWidth="300" HorizontalAlignment="Left" Height="30"/>
    </StackPanel>
    <Label Grid.Row="2" Name="lbl_SecVar" Margin="0,-2,0,0"  Height="30">Y axis Variables:</Label>
    <ListView Grid.Row="3" Name="lv_Canali" SelectionMode="Multiple" ScrollViewer.VerticalScrollBarVisibility="Visible">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
					<Setter Property="Foreground" Value="{Binding Foreground, Mode=TwoWay}"></Setter>
        </Style>
      </ListView.ItemContainerStyle>
    </ListView>

  </Grid>

</Window>
