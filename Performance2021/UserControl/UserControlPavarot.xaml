              <ComboBoxItem Content="All Manoeuvres"></ComboBoxItem>
              <ComboBoxItem Content="Tacks"></ComboBoxItem>
              <ComboBoxItem Content="Gybes"></ComboBoxItem>
          </ComboBox>
