        <Grid Grid.Column="0" Grid.Row="1" >
					    <Grid.ColumnDefinitions>
						    <ColumnDefinition Width="1*" />
						    <ColumnDefinition Width="3" MinWidth="3"/>
						    <ColumnDefinition Width="3*" />
					    </Grid.ColumnDefinitions>
					    <Grid.RowDefinitions>
						    <RowDefinition Height="220" />
						    <RowDefinition Height="3" MinHeight="3" />
						    <RowDefinition Height="5*" />
						    <RowDefinition Height="3" />
						    <RowDefinition Height="1*" />
					    </Grid.RowDefinitions>
					    <GridSplitter Name="PeriodsSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="#77000000" AllowDrop="True">
					    </GridSplitter>
					    <GridSplitter Name="HorizontalSplitter" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="#77000000" AllowDrop="True">
					    </GridSplitter>
					    <GridSplitter Name="HorizontalSplitter1" Grid.Column="0" Grid.Row="3" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="#77000000" AllowDrop="True">
					    </GridSplitter>


				      <ScrollViewer Grid.Column="0" Grid.Row="2">
					      <ItemsControl Name="IcTackGybesSelPeriods" ItemsSource="{Binding Lista}" >
							      <ItemsControl.ItemContainerStyle>
								      <Style>
									      <Setter Property="FrameworkElement.Margin" Value="0"/>
								      </Style>
							      </ItemsControl.ItemContainerStyle>
							      <ItemsControl.ItemTemplate>
								      <DataTemplate>
									      <Grid Margin="2,1,0,0">
										      <Grid.ColumnDefinitions>
										        <ColumnDefinition Width="20" />
										        <ColumnDefinition Width="25" />
											      <ColumnDefinition Width="*" />
											      <ColumnDefinition Width="50" />
										      </Grid.ColumnDefinitions>
										      <Grid.RowDefinitions>
											      <RowDefinition Height="30"></RowDefinition>
										      </Grid.RowDefinitions>
											      <Border BorderBrush="{Binding Colore, Converter={StaticResource converter}}" BorderThickness="3" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" ></Border>
											      <!--<CheckBox Checked="ItemChkBx_Checked" Unchecked="ItemChkBx_Unchecked" Name="ItemChkBx" HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="0,3,0,3" Grid.Column="1" Grid.Row="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"></CheckBox>-->
											      <CheckBox Click="ItemChbx_Click" Name="ItemChkBx" HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="0,3,0,3" Grid.Column="1" Grid.Row="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"></CheckBox>
														<TextBlock PreviewMouseRightButtonUp="TextBlock_PreviewMouseRightButtonUp" MouseMove="Period_MouseMove"  MouseLeave="Period_MouseLeave" FontSize="16" PreviewMouseUp="TextBlock_PreviewMouseUp" Grid.Column="2" Grid.Row="0" Background="{Binding ColoreSfondo, Converter={StaticResource converter}}" Text="{Binding DescrizioneBreve}" Margin="0,3,0,3"/>
				                    <TextBlock PreviewMouseRightButtonUp="TextBlock_PreviewMouseRightButtonUp" MouseMove="Period_MouseMove"  MouseLeave="Period_MouseLeave" FontSize="18" PreviewMouseUp="TextBlock_PreviewMouseUp"  Grid.Column="3" FontWeight="Bold" Grid.Row="0" Background="{Binding ColoreSfondo, Converter={StaticResource converter}}" TextAlignment="Right" Text="{Binding StrTempVal}" Margin="0,3,5,3"/>
														<Label MouseMove="Period_MouseMove"  MouseLeave="Period_MouseLeave" Background="{Binding Mure, Converter={StaticResource converter}}" Width="20" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"  Margin="4,4,4,4"></Label>
									      </Grid>
								      </DataTemplate>
							      </ItemsControl.ItemTemplate>
						      </ItemsControl>
					      </ScrollViewer>

                <!--<DockPanel Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" Grid.Row="0" Grid.Column="0">-->
      <ScrollViewer Grid.Column="0" Grid.Row="0" Grid.RowSpan="1" HorizontalScrollBarVisibility="Visible" CanContentScroll="False" VerticalScrollBarVisibility="Disabled" >
        
        <sc:SciChartSurface x:Name="GainLossVsTws" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" 
															        sc:ThemeManager.Theme="BrightSpark" 
															        Margin="3,2,3,2" Annotations="{Binding AnnotazioniGainLossVsTws}"
															        SeriesSource="{Binding GainLossVsTwsSeriesSource, Mode=OneWay}"
														        >
						         <sc:SciChartSurface.XAxes >
							          <sc:NumericAxis GrowBy="0.1,0.1"></sc:NumericAxis>
						         </sc:SciChartSurface.XAxes>
						         <sc:SciChartSurface.YAxes >
							          <sc:NumericAxis GrowBy="0.1,0.1"></sc:NumericAxis>
						         </sc:SciChartSurface.YAxes>
						         <sc:SciChartSurface.ChartModifier>
							        <sc:ModifierGroup>
                <sc:MouseWheelZoomModifier IsEnabled="{Binding PavarotSelectionSettings.WheelZoomEnabled}" ></sc:MouseWheelZoomModifier>
                <sc:ZoomPanModifier ReceiveHandledEvents="True" IsEnabled="{Binding PavarotSelectionSettings.ZoomPanEnabled}"/>
                  <sc:ZoomExtentsModifier ExecuteOn="MouseDoubleClick" IsAnimated="False"/>
								        <sc:CursorModifier IsEnabled="True"></sc:CursorModifier>
                <sc:DataPointSelectionModifier IsEnabled="{Binding PavarotSelectionSettings.DataPointSelEnabled}" SelectionChanged="DataPointSelectionModifier_SelectionChanged"></sc:DataPointSelectionModifier>
	  				          </sc:ModifierGroup>
  						       </sc:SciChartSurface.ChartModifier>
					        </sc:SciChartSurface>
      </ScrollViewer>

      <!--</DockPanel>-->
          
					      <ScrollViewer Grid.Column="2" Grid.Row="0" HorizontalScrollBarVisibility="Visible" CanContentScroll="False" VerticalScrollBarVisibility="Hidden">
                  <ItemsControl Name="ItmCtrl_BasicAvg" HorizontalAlignment="Stretch" ItemsSource="{Binding ControlliPavarotBasicAvg.ListaControlli,Mode=TwoWay}" >
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" >
                        </StackPanel>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>

					      <ScrollViewer Grid.Column="2" Grid.Row="2" Grid.RowSpan="3" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" VerticalScrollBarVisibility="Visible" >
					        <ItemsControl Name="ItmCtrl_PavarotCharts" HorizontalAlignment="Stretch" ItemsSource="{Binding ControlliPavarotBasicPlot.ListaControlli,Mode=TwoWay}" >
						        </ItemsControl>
					      </ScrollViewer>

		          <TextBlock FontSize="{Binding PeriodDetailsFontSize}" Grid.Column="0" Grid.Row="4" Text="{Binding CurrentPeriodDescription}" TextWrapping="Wrap">
							</TextBlock>
							<StackPanel Grid.Column="0" Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Orientation="Horizontal">
								<Button Click="FontSizeBigger" Content="+" Height="18" Width="20" Cursor="Hand"></Button>
								<Button Click="FontSizeSmaller" Content="-" Height="18" Width="20" Cursor="Hand"></Button>
							</StackPanel>
            </Grid>
