					<Viewbox>
						<Label Name="lblPort" >P</Label>
					</Viewbox>
				</ToggleButton>
				<ToggleButton x:Name="Stbd" IsChecked="True" Checked="TackState" Unchecked="TackState" >
					<Viewbox>
						<Label Name="lblStbd" >S</Label>
					</Viewbox>
				</ToggleButton>-->

      
