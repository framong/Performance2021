<UserControl x:Class="UserControlPavarot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             xmlns:sc="http://schemas.abtsoftware.co.uk/scichart"
             xmlns:estensioni="http://schemas.xceed.com/wpf/xaml/toolkit" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<UserControl.Resources>
		<local:clsColorConverter x:Key="converter"></local:clsColorConverter>
	</UserControl.Resources>
	
	<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Button Height="20" x:Name="btn_Refresh" Content="Refresh" Margin="5,0,5,0" Padding="5,0,5,0" MinWidth="80" VerticalAlignment="center"></Button>
      <Menu Height="20" Margin="10,0,10,0" Padding="5,0,5,0" Background="LightGray" BorderThickness="1" BorderBrush="Gray" >
        <MenuItem Header="Period Selection">
          <StackPanel Orientation="Horizontal">
            <Label FontSize="12" Content="Output Type" HorizontalContentAlignment="Right" Margin="5,0,0,0"></Label>
            <ComboBox FontSize="12" Name="OutPutType" SelectedItem="{Binding OutputType}" MinWidth="130" Margin="5,0,0,0">
            </ComboBox>
          </StackPanel>
          <CheckBox IsChecked="{Binding AutoRefreshGroupBy}" >Autorefresh also when in GroupBy/ColorBy OutputTypes</CheckBox>
          <CheckBox IsChecked="{Binding PlotTargetsIfAvailable}" >Plot Targets when available</CheckBox>
          <CheckBox IsChecked="{Binding PlotTrendLines}" >Plot Trend Lines</CheckBox>
          <Label Content="Manoeuvers selecton filters:"></Label>
          <MenuItem>
            <MenuItem.Header>
              <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding PavarotSelectionSettings.PerformanceSelected}" Padding="2,0,10,0" >Performances</CheckBox>
                <CheckBox IsChecked="{Binding PavarotSelectionSettings.TechnicalSelected}" >TecnicsAndSystems</CheckBox>
              </StackPanel>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem>
            <MenuItem.Header>
              <StackPanel Orientation="Horizontal">
                <CheckBox Content="Tacks" IsChecked="{Binding PavarotSelectionSettings.UpwindSelected}" Visibility="{Binding MostraFiltroTipo}" Width="80"></CheckBox>
                <CheckBox Content="Gybes" IsChecked="{Binding PavarotSelectionSettings.DownwindSelected}" Visibility="{Binding MostraFiltroTipo}" Width="80" Padding="0,0,5,0"></CheckBox>
                <CheckBox Content="Stbd Entry" IsChecked="{Binding PavarotSelectionSettings.StbdSelected}" Width="80"></CheckBox>
                <CheckBox Content="Port Entry" IsChecked="{Binding PavarotSelectionSettings.PortSelected}" Width="80"></CheckBox>
              </StackPanel>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem>
            <MenuItem.Header>
              <CheckBox IsChecked="{Binding PavarotSelectionSettings.ApplyTwsFilter}" Width="100">TWS Range</CheckBox>
            </MenuItem.Header>
            <MenuItem>
              <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                  <CheckBox  IsChecked="{Binding PavarotSelectionSettings.ApplyTwsMin}" IsEnabled="{Binding PavarotSelectionSettings.ApplyTwsFilter}" VerticalAlignment="Center" Content="Min" Width="50"></CheckBox>
                  <estensioni:DoubleUpDown FormatString="F1" Increment="0.1"  x:Name="UsNud_FilterTwsMin" IsEnabled="{Binding PavarotSelectionSettings.TwsMinEnabled}" Value="{Binding PavarotSelectionSettings.TwsMin}" ToolTip="Tws Min Value" Width="80" Height="25" Minimum="0" Maximum="50"></estensioni:DoubleUpDown>
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem>
              <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                  <CheckBox  IsChecked="{Binding PavarotSelectionSettings.ApplyTwsMax}" IsEnabled="{Binding PavarotSelectionSettings.ApplyTwsFilter}" VerticalAlignment="Center" Content="Max" Width="50"></CheckBox>
                  <estensioni:DoubleUpDown FormatString="F1" Increment="0.1"  x:Name="UsNud_FilterTwsMax" IsEnabled="{Binding PavarotSelectionSettings.TwsMaxEnabled}" Value="{Binding PavarotSelectionSettings.TwsMax}" ToolTip="Tws Max Value" Width="80" Height="25" Minimum="0" Maximum="50"></estensioni:DoubleUpDown>
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
          </MenuItem>
        </MenuItem>
      </Menu>

      <Menu Height="20"  Margin="5,0,5,0" Padding="5,0,5,0" MinWidth="80" Background="LightGray" BorderThickness="1" BorderBrush="Gray" >
        <MenuItem Header="Settings" ToolTip="Manoueuver Settings" >
          <MenuItem >
            <MenuItem.Header>
              <StackPanel Orientation="Horizontal">
                <Label ToolTip="Seconds before the head to wind when the tack's calculation starts" Width="100">Tacks Entry (ss)</Label>
                <estensioni:IntegerUpDown Value="{Binding PavSettings.TackSecAnte}" Width="50" Height="25"  ToolTip="Seconds before the head to wind when the tack's calculation starts"></estensioni:IntegerUpDown>
                <Label ToolTip="Seconds after the head/dead to wind when the manoeuver's calculation starts">ss</Label>
              </StackPanel>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem>
            <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Label ToolTip="Seconds after the head to wind when the tack's calculation ends" Width="100">Tacks Exit (ss)</Label>
                    <estensioni:IntegerUpDown Value="{Binding PavSettings.TackSecPost}" Width="50" Height="25"  ToolTip="Seconds after the head to wind when the tack's calculation ends"></estensioni:IntegerUpDown>
                    <Label ToolTip="Seconds after the head/dead to wind when the manoeuver's calculation ends">ss</Label>
                </StackPanel>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem >
            <MenuItem.Header>
              <StackPanel Orientation="Horizontal">
                <Label ToolTip="Seconds before the dead to wind when the gybe's calculation starts" Width="100">Gybes Entry (ss)</Label>
                <estensioni:IntegerUpDown Value="{Binding PavSettings.GybeSecAnte}" Width="50" Height="25"  ToolTip="Seconds before the dead to wind when the gybe's calculation starts"></estensioni:IntegerUpDown>
                <Label ToolTip="Seconds after the head/dead to wind when the manoeuver's calculation starts">ss</Label>
              </StackPanel>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem>
            <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Label ToolTip="Seconds after the dead to wind when the gybe's calculation ends" Width="100">Gybes Exit (ss)</Label>
                    <estensioni:IntegerUpDown Value="{Binding PavSettings.GybeSecPost}" Width="50" Height="25"  ToolTip="Seconds after the dead to wind when the gybe's calculation ends"></estensioni:IntegerUpDown>
                    <Label ToolTip="Seconds after the head/dead to wind when the manoeuver's calculation ends">ss</Label>
                </StackPanel>
            </MenuItem.Header>
          </MenuItem>
                    <!--<MenuItem >
            <MenuItem.Header>
              <StackPanel Orientation="Horizontal">
                <Label ToolTip="Seconds before the head/dead to wind when the investment time starts"  Width="100">Invest@ minus</Label>
                <estensioni:IntegerUpDown Value="{Binding PavarotSettings.SecsInvestment}" Width="50" Height="25" ToolTip="Seconds before the head/dead to wind when the investment time starts" ></estensioni:IntegerUpDown>
                <Label ToolTip="Seconds before the head/dead to wind when the investment time starts" >ss</Label>
              </StackPanel>
            </MenuItem.Header>
          </MenuItem>-->
          <!--<MenuItem >
            <MenuItem.Header>
              <StackPanel Orientation="Horizontal">
                <Label ToolTip="Seconds after the head/dead to wind when the xtra acceleration time ends"  Width="100">ExtraAcc@</Label>
                <estensioni:IntegerUpDown Value="{Binding PavarotSettings.SecsExtraAccel}" Width="50" Height="25" ToolTip="Seconds after the head/dead to wind when the xtra acceleration time ends" ></estensioni:IntegerUpDown>
                <Label ToolTip="Seconds after the head/dead to wind when the xtra acceleration time ends" >ss</Label>
              </StackPanel>
            </MenuItem.Header>
          </MenuItem>-->
        </MenuItem>
      </Menu>

      <Menu Height="20" Margin="5,0,5,0" Padding="5,0,5,0" MinWidth="80" HorizontalContentAlignment="Center" Background="LightGray" BorderThickness="1" BorderBrush="Gray">
        <MenuItem Header="Tools" >
          <MenuItem>
            <MenuItem.Header>
              <Button MinWidth="100" Margin="0,0,0,0" Padding="5,0,5,0" HorizontalContentAlignment="Left" x:Name="btn_Add" Command="{Binding CmdAggiungiCanale}" Content="Add Chart"></Button>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem>
            <MenuItem.Header>
              <Button x:Name="btn_SelectChannels"  MinWidth="100" Margin="0,0,0,0" Padding="5,0,5,0" HorizontalContentAlignment="Left" ToolTip="Select Report's Channels">Channels</Button>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem>
            <MenuItem.Header>
              <Button x:Name="btn_Pdf" Content="Pdf Report" ToolTip="Export Pdf Reports" MinWidth="100" Margin="0,0,0,0" Padding="5,0,5,0" HorizontalContentAlignment="Left" Click="btn_Pdf_Click"></Button>
            </MenuItem.Header>
          </MenuItem>
          <MenuItem>
            <MenuItem.Header>
              <Button x:Name="btn_ExportToBazzo" Content="Bazzo's file" Click="Btn_ExportToBazzo_Click" ToolTip="Export Bazzos File" MinWidth="100" Margin="0,0,0,0" Padding="5,0,5,0" HorizontalContentAlignment="Left" ></Button>
            </MenuItem.Header>
          </MenuItem>
          <!--<MenuItem>
            <MenuItem.Header>
              <Button Name="btn_PedestalStats" ToolTip="Export to Clipboard selected manoeuvers pedestals statistics" Click="btn_PedestalStats_Click" Content="PedStats"></Button>
            </MenuItem.Header>
          </MenuItem>-->
          <MenuItem>
            <MenuItem.Header>
              <Button Name="btn_UpdateKeys" MinWidth="100" Margin="0,0,0,0" Padding="5,0,5,0" HorizontalContentAlignment="Left"  Click="btn_UpdateKeys_Click" Width="100" Content="Update Keys" ToolTip="update KEYS property of the selected periods"></Button>
            </MenuItem.Header>
          </MenuItem>
        </MenuItem>
      </Menu>
      <ToggleButton IsChecked="{Binding PavarotSelectionSettings.WheelZoomEnabled}" Content="WheelZoom" ToolTip="Toggle mouse wheel zoom On/Off" MinWidth="80" Margin="5,0,5,0"  Padding="5,0,5,0" ></ToggleButton>
      <ToggleButton IsChecked="{Binding PavarotSelectionSettings.MouseModeSelEnabled}" Content="{Binding PavarotSelectionSettings.MouseModeSelDescription}" ToolTip="Mouse Move Mode: Selection/Pan" MinWidth="80"  Margin="5,0,5,0" Padding="5,0,5,0" ></ToggleButton>
      <Button Height="20" x:Name="btn_Recalc" Content="Recalc" Margin="5,0,5,0" Padding="5,0,5,0" MinWidth="80" VerticalAlignment="center"></Button>

      <Label  ToolTip="Daily/Selection Vmg Percentage (equivalent Tws) @ Tws" MinWidth="100" MinHeight="20" Content="{Binding PeriodsMng.VmgPercentage.Descrizione}"></Label>



    </StackPanel>
    <ToolBar Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" ToolBarTray.IsLocked="True" Visibility="Hidden">
