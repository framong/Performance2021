<Window x:Class="UserControlPolarSelect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="650"
        Height="100" Width="650"
             >
    <Grid>
        <StackPanel Orientation="Horizontal">
            <ComboBox Margin="10,0,0,0" FontSize="20" Height="50" Width="300" ItemsSource="{Binding ListaPolariDisponibili}"  x:Name="cmb_Polari">

            </ComboBox>
            <Button FontSize="20" Height="50" Width="100" Margin="30,0,0,0" Click="Button_Click" Content="Save"></Button>
            <Button FontSize="20" Height="50" Width="70" Margin="30,0,0,0"  Click="Button_Click_1" Content="Cancel"></Button>
            <Button FontSize="20" Height="50" Width="70" Margin="30,0,0,0"  Click="Button_Click_2" Content="Delete"></Button>
            
        </StackPanel>
    </Grid>
</Window>
