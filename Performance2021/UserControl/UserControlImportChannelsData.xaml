<Window x:Class="UserControlImportChannelsData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPwpf"
        xmlns:estensioni="http://schemas.xceed.com/wpf/xaml/toolkit" 
        mc:Ignorable="d"
        Title="Import Channels Data" Height="450" Width="800">
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="*"></RowDefinition>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180"></ColumnDefinition>
      <ColumnDefinition Width="40"></ColumnDefinition>
      <ColumnDefinition Width="*"></ColumnDefinition>
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Grid.Row="0">
      <Button IsEnabled="{Binding Abilita}" Content="Select File" Background="LightYellow" Margin="4,2,2,2" Width="70" Click="Button_Click"></Button>
      <TextBox IsEnabled="{Binding Abilita}" Name="txt_Filtro" Width="100" Text="{Binding TxtFiltro, Mode=TwoWay}" TextChanged="TextBox_TextChanged" ></TextBox>
      <Button IsEnabled="{Binding Abilita}" Content="Import" Background="LightGreen" Margin="50,2,2,2" Width="70" Click="Button_Click_1"></Button>
      <Button IsEnabled="{Binding Abilita}" Content="Cancel" Margin="30,2,2,2" Width="70" Click="Button_Click_2"></Button>      
      <Button Content="ManualUpdate" Margin="200,2,2,2" Width="100" Click="Button_Click_3"></Button>      
    </StackPanel>
    <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
      <Button IsEnabled="{Binding Abilita}" Name="btn_SelToNotSel" Content="&gt;&gt;" Margin="2,0,2,50" Click="btn_SelToNotSel_Click"></Button>
      <Button IsEnabled="{Binding Abilita}" Name="btn_NotSelToSel" Margin="2,0,2,0" Content="&lt;&lt;" Click="btn_NotSelToSel_Click"></Button>
    </StackPanel>


    <ListView  IsEnabled="{Binding Abilita}" x:Name="LV_Left" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding CanaliFileSelezionatoFiltrati}">
      <ListView.View>
        <GridView AllowsColumnReorder="True">
          <GridViewColumn DisplayMemberBinding="{Binding Intestazione}" Header="Channel Name" Width="150">
            
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>

    <ListView IsEnabled="{Binding Abilita}" x:Name="LV_Right" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding CanaliDaAggiungere}">
      <ListView.View>
        <GridView AllowsColumnReorder="False">
          <GridViewColumn DisplayMemberBinding="{Binding Intestazione}" Header="Channel Name" Width="150"></GridViewColumn>
          <GridViewColumn Header="Short Name" Width="155">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding ShortName}" Width="140" Margin="0"></TextBox>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Long Name" Width="155" >
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding LongName}" Width="140" Margin="0"></TextBox>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="DataType" Width="115">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}" Width="100"></ComboBox>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Dec" Width="60">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <estensioni:IntegerUpDown x:Name="UsNud_FilterMax"  Value="{Binding Decimals}" Width="45" Height="25" Maximum="9" Minimum="0"></estensioni:IntegerUpDown>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Unit" Width="65">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding LongUM}" Width="50" Margin="0"></TextBox>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Unt" Width="50">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding ShortUM}" Width="35" Margin="0"></TextBox>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>


  </Grid>
</Window>
