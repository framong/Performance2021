<UserControl x:Class="UserControlStraightLinePlotContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="700">
	<Grid Height="Auto" Name="GrigliaGrafico">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" ></RowDefinition>
			<RowDefinition Height="3" MinHeight="3"></RowDefinition>
		</Grid.RowDefinitions>

		<GridSplitter Name="SplitGrafici" DragCompleted="SplitGrafici_DragCompleted" Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="1" HorizontalAlignment="Stretch" Background="#77000000">
		</GridSplitter>
		
		<!--<ScrollViewer HorizontalScrollBarVisibility="Visible" CanContentScroll="False" VerticalScrollBarVisibility="Disabled">-->
      <ItemsControl Name="ItmCtrl_PeriodsCharts" HorizontalAlignment="Stretch" ItemsSource="{Binding ListaControlli}" >
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" >
              
            </StackPanel>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <!--qui vengono messi i grafici di confronto tra canali dei periodi selezionati-->
      </ItemsControl>
    <!--</ScrollViewer>-->
  </Grid>
</UserControl>
