<Window x:Class="UserControl_InputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPwpf"
        mc:Ignorable="d"
        Title="InputBox" Height="80" Width="400" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"></ColumnDefinition>
      <ColumnDefinition Width="70"></ColumnDefinition>
      <ColumnDefinition Width="70"></ColumnDefinition>
    </Grid.ColumnDefinitions>
    <TextBox Height="30" Background="AliceBlue" Name="txt_Testo"></TextBox>
    <Button Grid.Column="1" Content="OK" Height="30" Margin="4,0,4,0" IsDefault="True" Click="Button_Click"></Button>
    <Button Grid.Column="2" Content="cancel" Height="30" Margin="20,0,4,0" IsCancel="True" Click="Button_Click_1"></Button>
    </Grid>
</Window>
