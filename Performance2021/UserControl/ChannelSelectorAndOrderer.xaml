<Window x:Class="ChannelSelectorAndOrderer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPwpf"
        mc:Ignorable="d"
        Title="ChannelSelectorAndOrderer" Height="450" Width="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="30"></RowDefinition>
			<RowDefinition Height="30"></RowDefinition>
			<RowDefinition Height="*"></RowDefinition>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1*"></ColumnDefinition>
			<ColumnDefinition Width="40"></ColumnDefinition>
			<ColumnDefinition Width="1*"></ColumnDefinition>
		</Grid.ColumnDefinitions>
		<ToolBar Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Height="30">
			<Button Name="btn_Salva">Save</Button>
			<Button Name="btn_Cancel">Cancel</Button>
			<Button Name="btn_Reset">Reset</Button>
		</ToolBar>

		<Label VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="0">Selected Channels</Label>

    <ListView Name="ListaSelected" DisplayMemberPath="ChannelName" 
              ScrollViewer.VerticalScrollBarVisibility="Visible" 
              Grid.Column="0" Grid.Row="2" AllowDrop="True"
              PreviewMouseLeftButtonDown="ListaSelected_PreviewMouseLeftButtonDown"
              PreviewMouseMove="ListaSelected_PreviewMouseMove"
              PreviewMouseUp="ListaSelected_PreviewMouseUp"
              ItemsSource="{Binding CanaliSelezionati,Mode=TwoWay}"
              >
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <!--<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />-->
        </Style>
      </ListView.ItemContainerStyle>
    </ListView>
    <StackPanel Orientation="Vertical" Grid.Column="1" Grid.Row="2">
      <Button Name="btn_NotSelToSel" Margin="2,10,2,0" Content="&lt;&lt;"></Button>
      <Button Name="btn_SelToNotSel" Content="&gt;&gt;" Margin="2,10,2,0">
        
      </Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="2">
      <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" >Not Selected Channels</Label>
      <TextBox x:Name="txt_Search" Margin="2,0,0,0" Width="150" Background="Beige" TextAlignment="Left" FontSize="16" Text="{Binding FiltroCanale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
      <Button Content="x" ToolTip="Clear search" Cursor="Hand" Click="Button_Click" Width="15" Margin="2,2,2,2"></Button>
    </StackPanel>


    <ListView Name="ListaNotSelected" DisplayMemberPath="ChannelName" 
              ScrollViewer.VerticalScrollBarVisibility="Visible" 
              Grid.Column="2" Grid.Row="2" AllowDrop="True"
              PreviewMouseLeftButtonDown="ListaNotSelected_PreviewMouseLeftButtonDown"
              PreviewMouseMove="ListaNotSelected_PreviewMouseMove"
              ItemsSource="{Binding CanaliNonSelezionatiFiltrati, Mode=OneWay}"
              >
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <!--<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />-->
        </Style>
      </ListView.ItemContainerStyle>
    </ListView>
	</Grid>
</Window>
