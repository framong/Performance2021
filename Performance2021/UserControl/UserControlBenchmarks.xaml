<UserControl x:Class="UserControlBenchmarks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             mc:Ignorable="d" 
             xmlns:sc="http://schemas.abtsoftware.co.uk/scichart"
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="150" />
      <ColumnDefinition Width="3" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="25" />
      <RowDefinition Height="100" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <GridSplitter Name="SplitEventi" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="#77000000">
    </GridSplitter>



    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Background="LightGray">
      <ComboBox Margin="2" Width="195" ItemsSource="{Binding BM.ListaBenchmarks}" SelectedItem="{Binding BM.SelectedBenchmark}" DisplayMemberPath="FullName" SelectionChanged="ComboBox_SelectionChanged"></ComboBox>
      <!--<Button Margin="2" Content="Refresh" Click="Button_Click"></Button>-->
      <Button Width="80" Margin="20,2,5,2" Content="Save" Click="Button_Click_1"></Button>
      <Button Width="80" Margin="2" Content="Reload" Click="Button_Click_2"></Button>
      <Button Width="80" Margin="2" Content="Import" Click="Button_Click_3"></Button>
      <Button Width="80" Margin="2" Content="Delete" Click="Button_Click_4"></Button>
      <CheckBox x:Name="CB" Height="18" Margin="0" IsChecked="{Binding BM.DrawSameType}" Content="Draw Same Type" VerticalAlignment="Bottom"></CheckBox>
      <!--<TextBox KeyUp="TextBox_KeyUp" PreviewKeyDown="TextBox_PreviewKeyDown"></TextBox>-->
    </StackPanel>
    <StackPanel Orientation="Vertical" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="1" VerticalAlignment="Top" Background="LightGray" Margin="2,5,2,5">
      <StackPanel Margin="2"  Orientation="Horizontal" VerticalAlignment="Top" >
        <Label Height="25" Content="Line Name" ></Label>
        <TextBox Height="25" Width="130" Text="{Binding BM.SelectedBenchmark.Name}" VerticalContentAlignment="Center"></TextBox>
      </StackPanel>
      <StackPanel Margin="2"  Orientation="Horizontal" VerticalAlignment="Top" >
        <Label Height="25" Content="Type" ></Label>
        <ComboBox Name="BenchmarkTypes" Height="25" Margin="2" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" SelectedItem="{Binding BM.SelectedBenchmark.Type}" ></ComboBox>
      </StackPanel>
      <CheckBox Height="25" Margin="2" IsChecked="{Binding BM.SelectedBenchmark.Show}" Content="Show"></CheckBox>
    </StackPanel>


    <DataGrid x:Name="BenchDG" VerticalAlignment="Top" Grid.Row="3" Grid.ColumnSpan="1"
                ItemsSource="{Binding BM.SelectedBenchmark.Values}"
                AutoGenerateColumns="False" CanUserResizeColumns="True"
                FontSize="16" 
                GridLinesVisibility="Vertical" AlternatingRowBackground="LightGray" HeadersVisibility="Column"
                CanUserReorderColumns="False" 
                CellEditEnding="BenchDG_CellEditEnding"
              CurrentCellChanged="BenchDG_CurrentCellChanged"
              SelectedCellsChanged="BenchDG_SelectedCellsChanged"
                    >
      <DataGrid.Columns>
        <DataGridTextColumn Width="*"  Binding="{Binding X}">
          <DataGridTextColumn.Header>
            <TextBlock Text="RefChannel"></TextBlock>
          </DataGridTextColumn.Header>
          <DataGridTextColumn.EditingElementStyle>
            <Style TargetType="{x:Type TextBox}">
              <EventSetter Event="PreviewKeyDown" Handler="TextBox_KeyUp" />
            </Style>
          </DataGridTextColumn.EditingElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Width="*"  Binding="{Binding Y}">
          <DataGridTextColumn.Header>
            <TextBlock Text="Values"></TextBlock>
          </DataGridTextColumn.Header>
          <DataGridTextColumn.EditingElementStyle>
            <Style TargetType="{x:Type TextBox}">
              <EventSetter Event="PreviewKeyDown" Handler="TextBox_KeyUp" />
            </Style>
          </DataGridTextColumn.EditingElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>



    <sc:SciChartSurface x:Name="Plot"  
                                  sc:ThemeManager.Theme="BrightSpark"  
                                  Margin="0,0,0,0" 
                                  Grid.Column="2" Grid.Row="1" Grid.RowSpan="2"
                                  SeriesSource="{Binding BM.SeriesSource, Mode=TwoWay}"
                                  Cursor="Cross"
                                  >
      <sc:SciChartSurface.XAxes >
        <sc:NumericAxis GrowBy="0.1,0.1"></sc:NumericAxis>
      </sc:SciChartSurface.XAxes>
      <sc:SciChartSurface.YAxes >
        <sc:NumericAxis GrowBy="0.1,0.1"></sc:NumericAxis>
      </sc:SciChartSurface.YAxes>

      <sc:SciChartSurface.Annotations>
        <sc:TextAnnotation Text="{Binding BM.Titolo}" X1="0.5" Y1="0.0" FontSize="30" HorizontalAnchorPoint="Center" AnnotationCanvas="BelowChart" Foreground="#FF000000" CoordinateMode="Relative"></sc:TextAnnotation>
        <sc:TextAnnotation Text="{Binding BM.Ordinata}" X1="0.05" Y1="0.5" FontSize="30" HorizontalAnchorPoint="Left" VerticalAnchorPoint="Center" AnnotationCanvas="BelowChart" Foreground="#66000000" CoordinateMode="Relative">
          <sc:TextAnnotation.RenderTransform>
            <RotateTransform Angle="90"></RotateTransform>
          </sc:TextAnnotation.RenderTransform>
        </sc:TextAnnotation>
        <sc:TextAnnotation Text="{Binding BM.Ascissa}" X1="1" Y1="0.8" FontSize="30" HorizontalAnchorPoint="Right" AnnotationCanvas="BelowChart" Foreground="#66000000" CoordinateMode="Relative"></sc:TextAnnotation>
      </sc:SciChartSurface.Annotations>

      <sc:SciChartSurface.ChartModifier>
        <sc:ModifierGroup>
          <sc:MouseWheelZoomModifier ></sc:MouseWheelZoomModifier>
          <sc:ZoomPanModifier ReceiveHandledEvents="True"/>
          <sc:ZoomExtentsModifier ExecuteOn="MouseDoubleClick" IsAnimated="False"/>
          <sc:CursorModifier IsEnabled="True"></sc:CursorModifier>
          <sc:TooltipModifier ReceiveHandledEvents="True" 
                                        ShowTooltipOn="MouseHover" 
                                        UseInterpolation="True"/>
          <sc:LegendModifier  Name="lm" ShowLegend="{Binding BM.DrawSameType}" Orientation="Vertical" Margin="10"
                           LegendPlacement="Inside" GetLegendDataFor="AllSeries" HorizontalAlignment="Right" 
                       ShowVisibilityCheckboxes="True" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.IsDeferredScrollingEnabled="True"/>
        </sc:ModifierGroup>
      </sc:SciChartSurface.ChartModifier>
    </sc:SciChartSurface>

  </Grid>
</UserControl>
