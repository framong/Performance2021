<Window x:Class="UserControlSelFromList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             mc:Ignorable="d" Width="350"
             d:DesignHeight="450" d:DesignWidth="300" ResizeMode="NoResize" Topmost="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="30"></RowDefinition>
        <RowDefinition></RowDefinition>
      </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"></ColumnDefinition>
      <ColumnDefinition Width="100"></ColumnDefinition>
    </Grid.ColumnDefinitions>


    <StackPanel Grid.Column="0" Grid.Row="0"  Orientation="Horizontal">
      <Label Content="Search:"></Label>
      <TextBox x:Name="txtSearch" TextChanged="TextBox_TextChanged" Text="{Binding TestoRicerca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"></TextBox>
      <Button Content="X" Click="Button_Click_2" ToolTip="Clear Search"></Button>
    </StackPanel>
  
    <StackPanel HorizontalAlignment="Right" Grid.Column="1" Grid.Row="0"  Orientation="Horizontal">
      <Button Margin="2,2,2,2" Click="Button_Click" Content="Select"></Button>
      <Button Margin="10,2,2,2" Click="Button_Click_1" IsCancel="True" Content="Cancel"></Button>
    </StackPanel>

    <ListBox x:Name="ListaCanali" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" SelectionMode="{Binding SelMode}" MouseDoubleClick="ListaCanali_MouseDoubleClick" ItemsSource="{Binding ListaFiltrata}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Auto" >
      <ListBox.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}">
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Descrizione}"  Margin="0,0,5,0"/>
            <!--<TextBlock Text="{Binding IsSelected}" Foreground="Gray"/>-->
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

      <!--<ListBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" SelectionMode="Single" ItemsSource="{Binding Lista}" >
      
    </ListBox>-->
      
    </Grid>


</Window>
