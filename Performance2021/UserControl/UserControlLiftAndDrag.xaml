<UserControl x:Class="UserControlLiftAndDrag"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160"></ColumnDefinition>
      <ColumnDefinition Width="60"></ColumnDefinition>
      <ColumnDefinition Width="40"></ColumnDefinition>
      <ColumnDefinition Width="60"></ColumnDefinition>
      <ColumnDefinition Width="130"></ColumnDefinition>
      <ColumnDefinition Width="80"></ColumnDefinition>
      <ColumnDefinition Width="80"></ColumnDefinition>
      <ColumnDefinition Width="1*"></ColumnDefinition>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="*"></RowDefinition>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" >
      <Label Width="50" Content="Tws" HorizontalContentAlignment="Right"></Label>
      <TextBox Width="50" PreviewTextInput="NumericOnly" Text="{Binding Tws}"></TextBox>
      <Label Width="50" Content="Twa" HorizontalContentAlignment="Right"></Label>
      <TextBox Width="50" PreviewTextInput="NumericOnly" Text="{Binding Twa}"></TextBox>
      <Label Width="50" Content="Leeway" HorizontalContentAlignment="Right"></Label>
      <TextBox Width="50" PreviewTextInput="NumericOnly" Text="{Binding Leeway}"></TextBox>
      <Button Width="100" Margin="10,2,2,2" Content="Calculate" Grid.Row="1" Grid.Column="3" Click="Button_Click"></Button>
    </StackPanel>
      
      
      
      

      <Label  Grid.Column="5" Grid.Row="1" Content="TWS equiv." HorizontalContentAlignment="Right"></Label>
      <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="1" Text="{Binding TWSeq, StringFormat=F2}" HorizontalContentAlignment="Right"></TextBox>

      <Button Margin="3" Content="Update" Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="3" Click="Button_Click_1"></Button>
      
      <Label  Grid.Column="0" Grid.Row="1" Content="Air Flow Speed Kts" HorizontalContentAlignment="Right"></Label>
      <TextBox  Grid.Column="1" Grid.Row="1" PreviewTextInput="NumericOnly" Text="{Binding Aws, StringFormat=F1}"></TextBox>
      <Label  Grid.Column="0" Grid.Row="2" Content="Air Flow AoA (Awa-Lwy)" HorizontalContentAlignment="Right"></Label>
      <TextBox  Grid.Column="1" Grid.Row="2" PreviewTextInput="NumericOnly" Text="{Binding Awa, StringFormat=F1}"></TextBox>
    
      <Label  Grid.Column="0" Grid.Row="3" Content="Air Temperature [C]" HorizontalContentAlignment="Right"></Label>
    <TextBox  Grid.Column="1" Grid.Row="3" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.AirT, StringFormat=F1}"></TextBox>
      <Label  Grid.Column="0" Grid.Row="4" Content="Air Pressure [Millbar]" HorizontalContentAlignment="Right"></Label>
    <TextBox  Grid.Column="1" Grid.Row="4" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.AirP, StringFormat=F1}"></TextBox>
      <Label  Grid.Column="0" Grid.Row="5" Content="Humidity [%]" HorizontalContentAlignment="Right"></Label>
    <TextBox  Grid.Column="1" Grid.Row="5" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.RelHumidity, StringFormat=F0}"></TextBox>

      <Label  Grid.Column="0" Grid.Row="6" Content="Wing Span [m]" HorizontalContentAlignment="Right"></Label>
      <TextBox  Grid.Column="1" Grid.Row="6" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.WingSpan, StringFormat=F1}"></TextBox>
    <Label  Grid.Column="0" Grid.Row="7" Content="Wing Chord [m]" HorizontalContentAlignment="Right"></Label>
    <TextBox  Grid.Column="1" Grid.Row="7" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.WingChord, StringFormat=F1}"></TextBox>
    <Label  Grid.Column="0" Grid.Row="8" Content="Wing Camber [Chord%]" HorizontalContentAlignment="Right"></Label>
      <TextBox  Grid.Column="1" Grid.Row="8" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.WingCamber, StringFormat=F1}"></TextBox>
      <Label  Grid.Column="0" Grid.Row="9" Content="Wing Setting Angle [deg]" HorizontalContentAlignment="Right"></Label>
      <TextBox  Grid.Column="1" Grid.Row="9" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.WingSettingAngle, StringFormat=F1}"></TextBox>

      <Label  Grid.Column="0" Grid.Row="10" Content="Aoa/CL" HorizontalContentAlignment="Right"></Label>
    <TextBox  Grid.Column="1" Grid.Row="10" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.K, StringFormat=F3}"></TextBox>
      <Label  Grid.Column="0" Grid.Row="11" Content="Drag Coefficent" HorizontalContentAlignment="Right"></Label>
    <TextBox  Grid.Column="1" Grid.Row="11" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.DragK, StringFormat=F3}"></TextBox>
      <Label  Grid.Column="0" Grid.Row="12" Content="Wing Efficency Factor" HorizontalContentAlignment="Right"></Label>
    <TextBox  Grid.Column="1" Grid.Row="12" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragBaseLine.Settings.WingEfficencyFactor, StringFormat=F3}"></TextBox>


      <!--<Label  Grid.Column="2" Grid.Row="3" Content="Air Temperature [C]" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="3" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.AirT, StringFormat=F1}"></TextBox>
      <!--<Label  Grid.Column="2" Grid.Row="4" Content="Air Pressure [Millbar]" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="4" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.AirP, StringFormat=F1}"></TextBox>
      <!--<Label  Grid.Column="2" Grid.Row="5" Content="Humidity [%]" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="5" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.RelHumidity, StringFormat=F0}"></TextBox>

      <!--<Label  Grid.Column="2" Grid.Row="6" Content="Wing Span [m]" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="6" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.WingSpan, StringFormat=F1}"></TextBox>
    <!--<Label  Grid.Column="2" Grid.Row="7" Content="Wing Chord [m]" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="7" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.WingChord, StringFormat=F1}"></TextBox>
    <!--<Label  Grid.Column="2" Grid.Row="8" Content="Wing Camber [Chord%]" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="8" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.WingCamber, StringFormat=F1}"></TextBox>
      <!--<Label  Grid.Column="2" Grid.Row="9" Content="Wing Setting Angle [deg]" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="9" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.WingSettingAngle, StringFormat=F1}"></TextBox>

      <!--<Label  Grid.Column="2" Grid.Row="10" Content="Aoa/CL" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="10" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.K, StringFormat=F3}"></TextBox>
      <!--<Label  Grid.Column="2" Grid.Row="11" Content="Drag Coefficent" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="11" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.DragK, StringFormat=F3}"></TextBox>
      <!--<Label  Grid.Column="2" Grid.Row="12" Content="Wing Efficency Factor" HorizontalContentAlignment="Right"></Label>-->
    <TextBox  Grid.Column="3" Grid.Row="12" PreviewTextInput="NumericOnly" Text="{Binding LiftAndDragChanges.Settings.WingEfficencyFactor, StringFormat=F3}"></TextBox>

    <Label  Grid.Column="4" Grid.Row="2" Content="Driving Force" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="3" Content="Lateral Force" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="4" Content="Total Lift" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="5" Content="Lift X component" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="6" Content="Lift Y component" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="7" Content="Total Drag" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="8" Content="Drag At Zero Lift" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="9" Content="Induced Drag" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="10" Content="Drag X component" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="11" Content="Drag Y component" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="12" Content="CL" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="13" Content="Air Density" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="14" Content="Wing Area" HorizontalContentAlignment="Right"></Label>
    <Label  Grid.Column="4" Grid.Row="15" Content="Aspect Ratio" HorizontalContentAlignment="Right"></Label>

    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="2" Text="{Binding LiftAndDragBaseLine.DrivingForce, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="3" Text="{Binding LiftAndDragBaseLine.LateralForce, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="4" Text="{Binding LiftAndDragBaseLine.Lift, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="5" Text="{Binding LiftAndDragBaseLine.LiftVectorBoatAxisX, Mode=OneWay, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="6" Text="{Binding LiftAndDragBaseLine.LiftVectorBoatAxisY, Mode=OneWay, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="7" Text="{Binding LiftAndDragBaseLine.TotalDrag, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="8" Text="{Binding LiftAndDragBaseLine.DragAtZeroLift, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="9" Text="{Binding LiftAndDragBaseLine.InducedDrag, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="10" Text="{Binding LiftAndDragBaseLine.TotalDragVectorBoatAxisX, Mode=OneWay, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="11" Text="{Binding LiftAndDragBaseLine.TotalDragVectorBoatAxisY, Mode=OneWay, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="12" Text="{Binding LiftAndDragBaseLine.CiEl, StringFormat=F2}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="13" Text="{Binding LiftAndDragBaseLine.Rho, StringFormat=F5}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="14" Text="{Binding LiftAndDragBaseLine.WingArea, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="5" Grid.Row="15" Text="{Binding LiftAndDragBaseLine.AspectRatio, StringFormat=F2}" HorizontalContentAlignment="Right"></TextBox>

    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="2" Text="{Binding LiftAndDragChanges.DrivingForce, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="3" Text="{Binding LiftAndDragChanges.LateralForce, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="4" Text="{Binding LiftAndDragChanges.Lift, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="5" Text="{Binding LiftAndDragChanges.LiftVectorBoatAxisX, Mode=OneWay, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="6" Text="{Binding LiftAndDragChanges.LiftVectorBoatAxisY, Mode=OneWay, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="7" Text="{Binding LiftAndDragChanges.TotalDrag, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="8" Text="{Binding LiftAndDragChanges.DragAtZeroLift, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="9" Text="{Binding LiftAndDragChanges.InducedDrag, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="10" Text="{Binding LiftAndDragChanges.TotalDragVectorBoatAxisX, Mode=OneWay, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="11" Text="{Binding LiftAndDragChanges.TotalDragVectorBoatAxisY, Mode=OneWay, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="12" Text="{Binding LiftAndDragChanges.CiEl, StringFormat=F2}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="13" Text="{Binding LiftAndDragChanges.Rho, StringFormat=F5}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="14" Text="{Binding LiftAndDragChanges.WingArea, StringFormat=F1}" HorizontalContentAlignment="Right"></TextBox>
    <TextBox IsReadOnly="True" Grid.Column="6" Grid.Row="15" Text="{Binding LiftAndDragChanges.AspectRatio, StringFormat=F2}" HorizontalContentAlignment="Right"></TextBox>


  </Grid>
</UserControl>
