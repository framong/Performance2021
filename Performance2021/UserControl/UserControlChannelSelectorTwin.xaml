<Window x:Class="UserControlChannelSelectorTwin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             mc:Ignorable="d" 
             Height="500" Width="500" WindowStyle="ToolWindow" MaxWidth="500" 
        MinWidth="300" MinHeight="400"
        >
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="30"></RowDefinition>
      <RowDefinition Height="*"></RowDefinition>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*"></ColumnDefinition>
      <ColumnDefinition Width="40"></ColumnDefinition>
      <ColumnDefinition Width="1*"></ColumnDefinition>
    </Grid.ColumnDefinitions>
    <ToolBar Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Height="30">
      <Button Name="btn_Salva">Save</Button>
      <!--<Button Name="btn_Reset">Reset</Button>-->
      <Button Name="btn_Cancel">Cancel</Button>
    </ToolBar>

    <StackPanel Orientation="Horizontal"  Grid.Row="1" Grid.Column="0">
      <Label FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Center">Available Channels</Label>
      <TextBox x:Name="TxtBoxTestoFiltro" Text="{Binding TestoRicerca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="10,2,2,2"></TextBox>
      <Button Click="Button_Click_5">X</Button>
    </StackPanel>

    <ListView Name="ListaNotSelected" DisplayMemberPath="LongName" ItemsSource="{Binding ListaFiltrata, Mode=TwoWay}"
              ScrollViewer.VerticalScrollBarVisibility="Visible" SelectedItem="{Binding CanaleNonSelezionato, Mode=TwoWay}"
              Grid.Column="0" Grid.Row="2" AllowDrop="True"
              MouseDoubleClick="ListaNotSelected_MouseDoubleClick"
              >
      <!--<ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
      </ListView.ItemContainerStyle>-->
    </ListView>

    <StackPanel Orientation="Vertical" Grid.Column="1" Grid.Row="2">
      <Button Name="btn_NotSelToSel" Margin="2,10,2,0" Content="&gt;&gt;" Click="btn_NotSelToSel_Click"></Button>
      <Button Name="btn_SelToNotSel" Content="&lt;&lt;" Margin="2,10,2,0" Click="btn_SelToNotSel_Click"></Button>
      <Button Content="Top" Margin="2,20,2,0" Click="Button_Click" ></Button>
      <Button Content="Up" Margin="2,20,2,0" Click="Button_Click_1"></Button>
      <Button Content="Dn" Margin="2,20,2,0" Click="Button_Click_2"></Button>
      <Button Content="Btm" Margin="2,20,2,0" Click="Button_Click_3"></Button>
      <!--<Button Content="Del" Margin="2,20,2,0" Click="Button_Click_4"></Button>-->
    </StackPanel>

    <Label  FontWeight="Bold"  VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="2">Selected Channels</Label>

    <ListView Name="ListaSelected" DisplayMemberPath="LongName"  ItemsSource="{Binding CanaliSelezionati, Mode=TwoWay}"
              ScrollViewer.VerticalScrollBarVisibility="Visible" SelectedItem="{Binding CanaleSelezionato, Mode=TwoWay}"
              Grid.Column="2" Grid.Row="2" AllowDrop="True"
              MouseDoubleClick="ListaSelected_MouseDoubleClick"
              >
      <!--<ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
      </ListView.ItemContainerStyle>-->
    </ListView>

  </Grid>
</Window>
