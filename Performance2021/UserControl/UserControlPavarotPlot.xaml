<UserControl x:Class="UserControlPavarotPlot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
              xmlns:sc="http://schemas.abtsoftware.co.uk/scichart"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="700">
	<Grid Name="GrigliaGrafico" Height="200">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" ></RowDefinition>
			<RowDefinition Height="3" MinHeight="3"></RowDefinition>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"></ColumnDefinition>
			<ColumnDefinition Width="25"></ColumnDefinition>
		</Grid.ColumnDefinitions>
		<GridSplitter Name="SplitGrafici"  Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="1" HorizontalAlignment="Stretch" Background="#77000000">
		</GridSplitter>

		<sc:SciChartSurface x:Name="Plot" 
                        Grid.Row="0" Grid.Column="0" 
                        sc:ThemeManager.Theme="BrightSpark" Margin="3,2,3,2" 
                        sc:SciChartGroup.VerticalChartGroup="LrPavarotGroup"
                        SeriesSource="{Binding SeriesSource, Mode=OneWay}"
												MouseMove="SyncChartsMouseMove"
												>
			<sc:SciChartSurface.XAxes >
        <sc:NumericAxis GrowBy="0.02,0.02" VisibleRange="{Binding ParentVM.PavarotSyncViewModel.SharedXVisibleRange, Mode=TwoWay}"></sc:NumericAxis>
			</sc:SciChartSurface.XAxes>
			<sc:SciChartSurface.YAxes>
				<sc:NumericAxis GrowBy="0.1,0.1"></sc:NumericAxis>
			</sc:SciChartSurface.YAxes>
			<sc:SciChartSurface.Annotations>
				<sc:TextAnnotation Text="{Binding Titolo}" X1="0.0" Y1="-0.05" FontSize="20" AnnotationCanvas="BelowChart" Foreground="#FF000000" CoordinateMode="Relative"></sc:TextAnnotation>
          <sc:TextAnnotation Text="{Binding Sottotitolo}" X1="0.3" Y1="-0.02" FontSize="12" AnnotationCanvas="BelowChart" Foreground="#FF666666" CoordinateMode="Relative"></sc:TextAnnotation>
        <sc:VerticalLineAnnotation Stroke="red" StrokeThickness="3" X1="{Binding ParentVM.PavarotSyncViewModel.CurrentPosition}"
                                    CoordinateMode="RelativeY" Y1="0" Y2="0"></sc:VerticalLineAnnotation>
				<sc:HorizontalLineAnnotation Stroke="Gray" StrokeThickness="2" StrokeDashArray="2,2" X1="0" X2="1"
                                    CoordinateMode="RelativeX" Y1="0"></sc:HorizontalLineAnnotation>
        <sc:BoxAnnotation X1="{Binding ParentVM.PavarotSyncViewModel.InizioCampionamentoEntry}" X2="{Binding ParentVM.PavarotSyncViewModel.FineCampionamentoEntry}" Background="#22FFFF00" 
													BorderThickness="1" BorderBrush="Orange"
                                    CoordinateMode="RelativeY" Y1="-0.1" Y2="1.1" AnnotationCanvas="BelowChart"></sc:BoxAnnotation>
        <sc:BoxAnnotation X1="{Binding ParentVM.PavarotSyncViewModel.InizioCampionamentoExit}" X2="{Binding ParentVM.PavarotSyncViewModel.FineCampionamentoExit}" Background="#22FFFF00" 
													BorderThickness="1" BorderBrush="Orange"
                                    CoordinateMode="RelativeY" Y1="-0.1" Y2="1.1" AnnotationCanvas="BelowChart"></sc:BoxAnnotation>
			</sc:SciChartSurface.Annotations>
			<sc:SciChartSurface.Resources>
			</sc:SciChartSurface.Resources>
			<sc:SciChartSurface.ChartModifier>
				<sc:ModifierGroup>
          <sc:MouseWheelZoomModifier IsEnabled="{Binding ParentVM.PavarotSelectionSettings.WheelZoomEnabled, Mode=TwoWay}" XyDirection="XYDirection" ></sc:MouseWheelZoomModifier>
          <sc:ZoomPanModifier ReceiveHandledEvents="True" IsEnabled="{Binding ParentVM.PavarotSelectionSettings.ZoomPanEnabled}"/>
          <sc:ZoomExtentsModifier ExecuteOn="MouseDoubleClick" IsAnimated="False"/>
          <sc:CursorModifier IsEnabled="True"></sc:CursorModifier>
					<sc:RolloverModifier IsEnabled="True" ShowAxisLabels="True" ShowTooltipOn="MouseRightButtonDown"></sc:RolloverModifier>
          <sc:DataPointSelectionModifier IsEnabled="{Binding ParentVM.PavarotSelectionSettings.DataPointSelEnabled}" SelectionChanged="DataPointSelectionModifier_SelectionChanged"></sc:DataPointSelectionModifier>
				</sc:ModifierGroup>
			</sc:SciChartSurface.ChartModifier>
		</sc:SciChartSurface>

    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,20,0" >
      <Button Name="btn_ZoomExtends" Content="Extents" FontSize="8" Click="btn_ZoomExtents_Click" Margin="2,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
      <Button Name="btn_YExtends" Content="Yauto" FontSize="8" Click="btn_YExtends_Click" Margin="2,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
      <Button Name="btn_YzoomIn" Content="Yin" FontSize="8" Click="btn_YzoomIn_Click" Margin="2,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
      <Button Name="btn_YzoomOut" Content="Yout" FontSize="8" Click="btn_YzoomOut_Click" Margin="2,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
    </StackPanel>
    
    <StackPanel Grid.Column="1" Grid.Row="0">
      
			<Button Name="btn_Sel" Content="Sel" Width="25"></Button>
			<Button Name="btn_Top" Content="Top" Click="btn_Top_Click" Width="25"></Button>
			<Button Name="btn_Up" Content="Up" Width="25"></Button>
			<Button Name="btn_Dn" Content="Dn" Width="25"></Button>
			<Button Name="btn_Btm" Content="Btm" Click="btn_Btm_Click" Width="25"></Button>
			<Button Name="btn_Del" Content="Del" Width="25"></Button>
			<ToggleButton Name="btn_Sign" IsChecked="{Binding ToggleSigned}" Content="Sgn" Width="25" Margin="0,10,0,0"></ToggleButton>
			<ToggleButton Name="btn_Deriv" IsChecked="{Binding ValoriDerivati}" Content="Der" Width="25" Margin="0,2,0,0"></ToggleButton>
			<ToggleButton Name="btn_Smussa" IsChecked="{Binding Smussa}" Visibility="{Binding SmussaVisibility}" Content="Smt" ToolTip="Smooth the delta channel curves" Width="25" Margin="0,2,0,0"></ToggleButton>
      
		</StackPanel>
	</Grid>
</UserControl>
