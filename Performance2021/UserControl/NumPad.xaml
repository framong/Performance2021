<Window x:Class="NumPad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPwpf"
        mc:Ignorable="d"
        Title="NumPad" Height="600" Width="400">
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="3*"></RowDefinition>
      <RowDefinition Height="2*"></RowDefinition>
      <RowDefinition Height="2*"></RowDefinition>
      <RowDefinition Height="2*"></RowDefinition>
      <RowDefinition Height="2*"></RowDefinition>
      <RowDefinition Height="2*"></RowDefinition>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition></ColumnDefinition>
      <ColumnDefinition></ColumnDefinition>
      <ColumnDefinition></ColumnDefinition>
    </Grid.ColumnDefinitions>
    <Label Content="{Binding ValueString}" HorizontalContentAlignment="Right" VerticalContentAlignment="Top" FontSize="70" FontWeight="Bold" Background="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="2" Foreground="White" ></Label>
    <Button Content="1" Grid.Column="0" Grid.Row="1" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="2" Grid.Column="1" Grid.Row="1" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="3" Grid.Column="2" Grid.Row="1" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="4" Grid.Column="0" Grid.Row="2" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="5" Grid.Column="1" Grid.Row="2" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="6" Grid.Column="2" Grid.Row="2" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="7" Grid.Column="0" Grid.Row="3" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="8" Grid.Column="1" Grid.Row="3" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="9" Grid.Column="2" Grid.Row="3" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="0" Grid.Column="1" Grid.Row="4" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="." Grid.Column="2" Grid.Row="4" FontSize="70" FontWeight="ExtraBold" Background="LightYellow"></Button>
    <Button Content="Zero" Grid.Column="0" Grid.Row="4" FontSize="40" FontWeight="Normal" Background="LightYellow"></Button>
    <Button Content="Cancel" Grid.Column="0" Grid.Row="5" FontSize="40" FontWeight="Normal" Background="Orange"></Button>
    <Button Content="SAVE" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="5" FontSize="70" FontWeight="Normal" Background="LightGreen"></Button>
  </Grid>
</Window>
