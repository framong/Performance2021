<Window x:Class="LeewayModelForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPwpf"
        mc:Ignorable="d"
        Title="Leeway Model" Height="760" Width="980"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <local:clsDecimalFlexConverter x:Key="DecimalFlex" />
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="380" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="150" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                 Text="Theoretical leeway = K * Kc * M / (V^2 * S) - canard incidence term. Adjust the coefficients by hand, or mark the ones to adapt and press Fit: the coefficients are tuned so that the model follows the reference series over the chosen range. Pick a range without current when the reference is the COG - HDG leeway." />
      <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
        <Label Content="Reference" Width="130" VerticalAlignment="Center" />
        <ComboBox Name="cmb_Riferimento" Width="320" VerticalAlignment="Center"
                  ToolTip="Series the model has to match. Leeway Normalized is the logged leeway, Leeway Recalc is the heading minus course over ground (reliable only without current)." />
        <RadioButton Name="rdb_Visibile" Content="Visible plot range" Margin="20,0,0,0" VerticalAlignment="Center" IsChecked="True"
                     ToolTip="Fit only on the time range currently visible in the Data Plots" />
        <RadioButton Name="rdb_Tutto" Content="Whole file" Margin="15,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
        <Label Content="Canard angle channel" Width="130" VerticalAlignment="Center" />
        <TextBox Name="txt_CanAngolo" Width="150" VerticalContentAlignment="Center" Height="24"
                 ToolTip="Exact channel name. Empty = automatic search (Canard, Dagger or Board with Angle in the name)" />
        <Label Content="Immersion" Margin="10,0,0,0" VerticalAlignment="Center" />
        <TextBox Name="txt_CanImmersione" Width="150" VerticalContentAlignment="Center" Height="24"
                 ToolTip="Exact channel name. Empty = automatic search (Canard, Dagger or Board with Immersion in the name)" />
        <Label Content="Keel cant" Margin="10,0,0,0" VerticalAlignment="Center" />
        <TextBox Name="txt_Cant" Width="150" VerticalContentAlignment="Center" Height="24"
                 ToolTip="Exact channel name. Empty = a few known names are tried (KeelCant, KeelAngle, CantAngle, Cant); if none exists the keel cant is ignored" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="130,4,0,6">
        <CheckBox Name="chk_AngoloPerMura" Content="Canard angle signed by tack"
                  ToolTip="Tick if the canard angle channel is positive to starboard (it is then flipped on port tack so positive means windward)" />
        <CheckBox Name="chk_CantPerMura" Content="Keel cant signed by tack" Margin="20,0,0,0"
                  ToolTip="Tick if the keel cant channel is positive to starboard (it is then flipped on port tack so positive means windward)" />
        <CheckBox Name="chk_CantInvertito" Content="Invert keel cant sign" Margin="20,0,0,0"
                  ToolTip="Applied after the previous option: positive must mean the keel bulb moved toward windward" />
      </StackPanel>
    </StackPanel>

    <DataGrid Grid.Row="1" Name="grd_Parametri" AutoGenerateColumns="False" CanUserAddRows="False"
              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="All"
              RowHeaderWidth="0" AlternatingRowBackground="#FFF5F5F5">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Coefficient" Width="80" IsReadOnly="True" Binding="{Binding Nome}" />
        <DataGridTextColumn Header="Value" Width="90" Binding="{Binding Valore, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalFlex}}" />
        <DataGridTextColumn Header="Min" Width="70" Binding="{Binding Minimo, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalFlex}}" />
        <DataGridTextColumn Header="Max" Width="70" Binding="{Binding Massimo, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalFlex}}" />
        <DataGridCheckBoxColumn Header="Fit" Width="40" Binding="{Binding DaAdattare, UpdateSourceTrigger=PropertyChanged}" />
        <DataGridTextColumn Header="Default" Width="70" IsReadOnly="True" Binding="{Binding Predefinito}" />
        <DataGridTextColumn Header="Description" Width="*" IsReadOnly="True" Binding="{Binding Descrizione}" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBox Grid.Row="2" Name="txt_Report" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Name="btn_Valuta" Content="Evaluate" Width="90" Margin="5" Click="btn_Valuta_Click"
              ToolTip="Error of the model against the reference with the current coefficients" />
      <Button Name="btn_Fit" Content="Fit" Width="90" Margin="5" Click="btn_Fit_Click"
              ToolTip="Adapt the coefficients marked Fit to the reference series" />
      <Button Name="btn_Defaults" Content="Reset Defaults" Width="110" Margin="5" Click="btn_Defaults_Click" />
      <Button Name="btn_SaveAndRefresh" Content="Save and Refresh" Width="130" Margin="5" Click="btn_SaveAndRefresh_Click"
              ToolTip="Save the coefficients and recompute the Leeway Model channel" />
      <Button Name="btn_Save" Content="Save" Width="90" Margin="5" IsDefault="True" Click="btn_Save_Click" />
      <Button Name="btn_Cancel" Content="Cancel" Width="90" Margin="5" IsCancel="True" Click="btn_Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>
