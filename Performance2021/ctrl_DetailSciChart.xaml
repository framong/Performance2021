<UserControl x:Class="ctrl_DetailSciChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sc="http://schemas.abtsoftware.co.uk/scichart"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SPwpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

	<Grid Name="GrigliaGraficoDettaglio">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="2"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="30"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" ></RowDefinition>
			<RowDefinition Height="4" ></RowDefinition>
		</Grid.RowDefinitions>
		<GridSplitter Name="SplitDati" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Background="LightGray" >
			<!--DragStarted="GridSplitter_DragStarted" DragCompleted="GridSplitter_DragCompleted"  >-->

		</GridSplitter>
    <StackPanel>
		<StackPanel Name="StackDisplays">
      
		</StackPanel>
    <!--<StackPanel Name="io" MinHeight="50">
        <Label Content="monge"></Label>
        <Label Content="{Binding ZoomEnabled}" Background="Red"></Label>
    </StackPanel>-->
    </StackPanel>
    <!--<TextBox Name="txt_dati"></TextBox>-->
		<GridSplitter Name="SplitGrafici"  Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Background="LightGray" Grid.ColumnSpan="4">
			<!--DragStarted="GridSplitter_DragStarted" DragCompleted="GridSplitter_DragCompleted"  >-->

		</GridSplitter>


		<sc:SciChartSurface x:Name="SCsurface" sc:ThemeManager.Theme="BrightSpark" Margin="3,2,3,2"  Grid.Row="0" Grid.Column="2" MinHeight="200">

			<sc:SciChartSurface.ChartModifier>
				
				<sc:ModifierGroup sc:MouseManager.MouseEventGroup="MyMouseEventGroup">
					<sc:RubberBandXyZoomModifier IsAnimated="False" Name="ScRubberBandXyZoomModifier" IsEnabled="False" IsXAxisOnly="False" RubberBandFill="#99FF0000"></sc:RubberBandXyZoomModifier>
					<sc:MouseWheelZoomModifier Name="ScMouseWheelZoomModifier" XyDirection="{Binding ZoomMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></sc:MouseWheelZoomModifier>
					<sc:ZoomPanModifier Name="ScZoomPanModifier" ReceiveHandledEvents="True" IsEnabled="True"/>
					<!--<sc:ZoomExtentsModifier ExecuteOn="MouseDoubleClick"/>-->
					<!--<sc:CursorModifier IsEnabled="True"></sc:CursorModifier>-->
					<!--<sc:RolloverModifier IsEnabled="True"></sc:RolloverModifier>-->
					<!--<sc:RolloverModifier IsEnabled="{Binding RolloverEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></sc:RolloverModifier>-->
          <sc:VerticalSliceModifier Name="BarraVericale" IsEnabled="True" Visibility="Visible"  ReceiveHandledEvents="True" >
            <sc:VerticalSliceModifier.VerticalLines>
              <sc:VerticalLineAnnotation  LabelPlacement="Axis" StrokeThickness="6"  ShowLabel="True"    Visibility="Visible" 
                                                                    X1="{Binding VerticalBarPosition, Mode=TwoWay}"    Name="currentPositionVerticalLine"
                                                                             >
              </sc:VerticalLineAnnotation>
            </sc:VerticalSliceModifier.VerticalLines>



          </sc:VerticalSliceModifier>
				</sc:ModifierGroup>
			</sc:SciChartSurface.ChartModifier>
			<!--<sc:SciChartSurface.Annotations>
				<sc:VerticalLineAnnotation Name="BarraVericale" IsEnabled="True" Visibility="Visible" X1="{Binding VerticalBarPosition, Mode=TwoWay}" Stroke="Blue" StrokeThickness="2"/>
				--><!--<sc:VerticalLineAnnotation Name="BarraVericale" X1="300" Stroke="Orange" StrokeThickness="2"/>--><!--
			</sc:SciChartSurface.Annotations>-->
		</sc:SciChartSurface>
		<StackPanel Grid.Column="3" Grid.Row="0" >
			<Button Name="btn_Select" Content="Sel" Height="25" Margin="0,4,2,2" VerticalAlignment="Top" Width="25" HorizontalAlignment="Right"/>
			<Button Name="btn_ToggleYaxes" Content="Yax" Height="25" Margin="0,4,2,2" VerticalAlignment="Top" Width="25" HorizontalAlignment="Right"/>
			<Button Name="btn_180mode" Content="Nrm" Height="25" Margin="0,4,2,2" VerticalAlignment="Top" Width="25" HorizontalAlignment="Right"/>
			<Button Name="btn_MoveUp" Content="Up" Height="25" Margin="0,10,0,2" VerticalAlignment="Top" Width="25"/>
			<Button Name="btn_MoveDn" Content="Dn" Height="25" Margin="0,2,0,2" VerticalAlignment="Top" Width="25"/>
			<Button Name="btn_Del" Content="Del" Height="25" Margin="0,20,0,2" VerticalAlignment="Top" Width="25"/>
		</StackPanel>
	</Grid>
</UserControl>
